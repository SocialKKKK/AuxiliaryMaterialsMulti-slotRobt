<UserControl x:Class="WireCabinet.Hmi.Views.OperationLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">
    <!-- 1024×768 固定分辨率、禁止滚动（HMI界面约束 §2）：两行筛选 + 工具栏 + 恰好 20 行列表 -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 筛选区：六项条件，各自可选、可任意组合 -->
        <Border Grid.Row="0" Style="{StaticResource CardPanel}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="42"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="时间范围" Style="{StaticResource LabelText}" VerticalAlignment="Center" Width="60"/>
                    <TextBox x:Name="TsFromBox" Style="{StaticResource IndustrialTextBox}" Width="118"/>
                    <TextBlock Text="至" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="6,0"/>
                    <TextBox x:Name="TsToBox" Style="{StaticResource IndustrialTextBox}" Width="118"/>
                    <TextBlock Text="物料批号" Style="{StaticResource LabelText}" VerticalAlignment="Center" Width="60" Margin="16,0,0,0"/>
                    <TextBox x:Name="LotNoBox" Style="{StaticResource IndustrialTextBox}" Width="150"/>
                    <TextBlock Text="格口编号" Style="{StaticResource LabelText}" VerticalAlignment="Center" Width="60" Margin="16,0,0,0"/>
                    <TextBox x:Name="SlotNoBox" Style="{StaticResource IndustrialTextBox}" Width="100"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="操作人" Style="{StaticResource LabelText}" VerticalAlignment="Center" Width="60"/>
                    <TextBox x:Name="OperatorBox" Style="{StaticResource IndustrialTextBox}" Width="100"/>
                    <TextBlock Text="机台号" Style="{StaticResource LabelText}" VerticalAlignment="Center" Width="60" Margin="16,0,0,0"/>
                    <TextBox x:Name="EqpNoBox" Style="{StaticResource IndustrialTextBox}" Width="100"/>
                    <TextBlock Text="动作类型" Style="{StaticResource LabelText}" VerticalAlignment="Center" Width="72" Margin="16,0,0,0"/>
                    <ComboBox x:Name="ActionTypeBox" Style="{StaticResource IndustrialComboBox}" Width="170"/>
                    <Button x:Name="SearchBtn" Content="查询" Style="{StaticResource PrimaryButton}"
                            MinWidth="88" Margin="20,0,0,0" Click="Search_Click"/>
                    <Button x:Name="ResetBtn" Content="重置" Style="{StaticResource SecondaryButton}"
                            MinWidth="88" Margin="8,0,0,0" Click="Reset_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 工具栏：分页 / 追溯 / 导出 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SummaryText" Text="—" Style="{StaticResource ValueText}" VerticalAlignment="Center"/>
                <Button x:Name="PrevPageBtn" Content="上一页" Style="{StaticResource SecondaryButton}"
                        MinWidth="88" Margin="16,0,0,0" Click="PrevPage_Click"/>
                <Button x:Name="NextPageBtn" Content="下一页" Style="{StaticResource SecondaryButton}"
                        MinWidth="88" Margin="8,0,0,0" Click="NextPage_Click"/>
                <Button x:Name="BackToListBtn" Content="返回列表" Style="{StaticResource SecondaryButton}"
                        MinWidth="104" Margin="16,0,0,0" Click="BackToList_Click" Visibility="Collapsed"/>
                <!-- 归一屏放不下的是提示文案，故给状态消息限宽并裁尾，而不是让它把按钮挤出去 -->
                <TextBlock x:Name="StatusText" Text="" Style="{StaticResource HintText}" VerticalAlignment="Center"
                           Margin="14,0,0,0" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="TraceBtn" Content="追溯全程" Style="{StaticResource SecondaryButton}"
                        MinWidth="104" Click="Trace_Click"/>
                <Button x:Name="ExportBtn" Content="导出 Excel" Style="{StaticResource PrimaryButton}"
                        MinWidth="130" Margin="8,0,0,0" Click="Export_Click"/>
            </StackPanel>
        </Grid>

        <!-- 列表：固定 20 行高度，一屏内看完，不触发滚动 -->
        <Border Grid.Row="4" Style="{StaticResource CardPanel}" Padding="6,4,6,6">
            <ListView x:Name="RecordList" BorderThickness="0" Background="Transparent"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Height" Value="23"/>
                        <Setter Property="Padding" Value="2,0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="时间" DisplayMemberBinding="{Binding TsText}" Width="150"/>
                        <GridViewColumn Header="动作类型" DisplayMemberBinding="{Binding ActionText}" Width="140"/>
                        <GridViewColumn Header="操作人" DisplayMemberBinding="{Binding OperatorText}" Width="118"/>
                        <GridViewColumn Header="格口" DisplayMemberBinding="{Binding SlotNo}" Width="72"/>
                        <GridViewColumn Header="焊丝批号" DisplayMemberBinding="{Binding LotNo}" Width="140"/>
                        <GridViewColumn Header="机台号" DisplayMemberBinding="{Binding EqpNo}" Width="76"/>
                        <GridViewColumn Header="结果" DisplayMemberBinding="{Binding ResultText}" Width="64"/>
                        <GridViewColumn Header="失败原因 / 说明" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- 失败原因可能很长（如 ORA 原文），列表里裁尾显示省略号；
                                         完整内容在导出的 Excel 里 -->
                                    <TextBlock Text="{Binding DetailText}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</UserControl>
