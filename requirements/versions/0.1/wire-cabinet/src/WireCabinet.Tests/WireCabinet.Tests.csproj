<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    只引用非 WPF 层：WireCabinet.Hmi 是 net8.0-windows，net8.0 测试工程无法引用。
    Windows 上的 AgvServices 集成验证由独立 WireCabinet.Hmi.Tests 工程覆盖。
  -->
  <ItemGroup>
    <ProjectReference Include="..\WireCabinet.Core\WireCabinet.Core.csproj" />
    <ProjectReference Include="..\WireCabinet.Data\WireCabinet.Data.csproj" />
    <ProjectReference Include="..\WireCabinet.Flow\WireCabinet.Flow.csproj" />
    <ProjectReference Include="..\WireCabinet.Slots\WireCabinet.Slots.csproj" />
    <ProjectReference Include="..\WireCabinet.Rcs\WireCabinet.Rcs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
  </ItemGroup>

</Project>
